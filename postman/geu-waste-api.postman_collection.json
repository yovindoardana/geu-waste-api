    {
      "name": "5. Business Rules & Error Validation",
      "item": [
        {
          "name": "BR02: Reject E-Waste Without Safety Confirmation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Returns BUSINESS_RULE_VIOLATION\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.code).to.eql(\"BUSINESS_RULE_VIOLATION\");",
                  "    pm.expect(jsonData.message).to.include(\"electronic\");",
                  "});"
                ],
                "type": "text/javascript"
              }
