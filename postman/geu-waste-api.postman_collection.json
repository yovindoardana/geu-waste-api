        {
          "name": "Confirm Payment with Proof Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Payment confirmed with status paid and proof_url\", function () {",
